+// Offline PTY tests for SerialPort. Run only in a PID/network/device-isolated
+// bubblewrap namespace: no real serial or motor device is accessed.
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <pty.h>
+#include <sys/ioctl.h>
+#include <sys/select.h>
+#include <unistd.h>
+
+#include "serial_port.h"
+
+static bool inject_exclusive_failure = false;
+static bool inject_release_failure = false;
+static bool inject_termios_failure = false;
+static int injected_fd = -1;
+static int exclusive_requests = 0;
+
+extern "C" int __real_ioctl(int fd, unsigned long request, ...);
+extern "C" int __wrap_ioctl(int fd, unsigned long request, ...) {
+    if (request == TIOCEXCL) {
+        ++exclusive_requests;
+        if (inject_exclusive_failure) {
+            injected_fd = fd;
+            errno = EIO;
+            return -1;
+        }
+        return __real_ioctl(fd, request);
+    }
+    if (request == TIOCNXCL) {
+        if (inject_release_failure) {
+            injected_fd = fd;
+            errno = EIO;
+            return -1;
+        }
+        return __real_ioctl(fd, request);
+    }
+    va_list args;
+    va_start(args, request);
+    void *arg = va_arg(args, void *);
+    va_end(args);
+    return __real_ioctl(fd, request, arg);
+}
+
+extern "C" int __real_tcgetattr(int fd, struct termios *attributes);
+extern "C" int __wrap_tcgetattr(int fd, struct termios *attributes) {
+    if (inject_termios_failure) {
+        injected_fd = fd;
+        errno = EIO;
+        return -1;
+    }
+    return __real_tcgetattr(fd, attributes);
+}
+
+// During the red phase, the old interface has no bool argument and the
+// fallback exercises its actual nonexclusive open. The bool overload is used
+// automatically once implemented, without adding test-only product code.
+template <typename T>
+auto open_watchdog(T &port, int) -> decltype(port.openPort(true)) {
+    return port.openPort(true);
+}
+template <typename T>
+int open_watchdog(T &port, ...) { return port.openPort(); }
+
+static void require(bool condition, const char *message) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s (errno=%d)\n", message, errno);
+        std::exit(1);
+    }
+}
+
+struct Pty {
+    int master;
+    int slave;
+    char path[128];
+    Pty() : master(-1), slave(-1) {
+        require(openpty(&master, &slave, path, NULL, NULL) == 0, "open own PTY");
+        require(std::strncmp(path, "/dev/pts/", 9) == 0, "device must be a PTY");
+    }
+    ~Pty() { if (slave >= 0) close(slave); if (master >= 0) close(master); }
+};
+
+static void test_default_is_nonexclusive() {
+    Pty pty;
+    const int prior = exclusive_requests;
+    AgileX::SerialPort port(pty.path, B38400);
+    require(port.openPort() == 0, "legacy open");
+    int second = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    require(second >= 0, "legacy mode must permit a second open");
+    close(second);
+    require(exclusive_requests == prior, "legacy mode must not request TIOCEXCL");
+}
+
+static void test_watchdog_excludes_new_opens_and_releases() {
+    Pty pty;
+    AgileX::SerialPort port(pty.path, B38400);
+    require(open_watchdog(port, 0) == 0, "watchdog serial open");
+    errno = 0;
+    int second = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    const int open_errno = errno;
+    if (second >= 0) close(second);
+    require(second < 0 && open_errno == EBUSY, "watchdog mode must block later open");
+    require(fcntl(pty.slave, F_GETFD) >= 0, "preexisting PTY descriptor remains open");
+    require(write(pty.slave, "Z", 1) == 1, "preexisting PTY descriptor remains writable");
+    fd_set ready;
+    FD_ZERO(&ready);
+    FD_SET(pty.master, &ready);
+    struct timeval timeout = {1, 0};
+    require(select(pty.master + 1, &ready, NULL, NULL, &timeout) == 1,
+            "preexisting descriptor data reaches PTY master");
+    char byte = 0;
+    require(read(pty.master, &byte, 1) == 1 && byte == 'Z', "preexisting writer is not revoked");
+    require(open_watchdog(port, 0) != 0, "same SerialPort cannot open twice");
+    require(port.closePort() == 0, "close exclusive port");
+    require(port.isOpen() == -1, "closed port must report closed");
+    int reopened = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    require(reopened >= 0, "clean close must release exclusion while PTY master is open");
+    close(reopened);
+}
+
+static void test_failed_exclusive_ioctl_closes_new_descriptor() {
+    Pty pty;
+    AgileX::SerialPort port(pty.path, B38400);
+    inject_exclusive_failure = true;
+    injected_fd = -1;
+    const int result = open_watchdog(port, 0);
+    const int saved_errno = errno;
+    inject_exclusive_failure = false;
+    require(result != 0 && saved_errno == EIO, "TIOCEXCL error must reject startup");
+    require(port.isOpen() == -1 && injected_fd >= 0, "failed exclusive open is closed");
+    errno = 0;
+    require(fcntl(injected_fd, F_GETFD) < 0 && errno == EBADF, "failed fd must be closed");
+    int retry = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    require(retry >= 0, "TIOCEXCL failure must leave PTY openable");
+    close(retry);
+}
+
+static void test_later_setup_failure_releases_and_closes() {
+    Pty pty;
+    AgileX::SerialPort port(pty.path, B38400);
+    inject_termios_failure = true;
+    injected_fd = -1;
+    const int result = open_watchdog(port, 0);
+    const int saved_errno = errno;
+    inject_termios_failure = false;
+    require(result != 0 && saved_errno == EIO && injected_fd >= 0, "termios error must fail");
+    require(port.isOpen() == -1, "termios error must reset fd state");
+    errno = 0;
+    require(fcntl(injected_fd, F_GETFD) < 0 && errno == EBADF, "termios failure fd closed");
+    int retry = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    require(retry >= 0, "setup failure must release exclusion");
+    close(retry);
+}
+
+static void test_explicit_close_never_closes_a_reused_descriptor() {
+    Pty pty;
+    int reused = -1;
+    {
+        AgileX::SerialPort port(pty.path, B38400);
+        require(port.openPort() == 0 && port.closePort() == 0, "explicit legacy close");
+        reused = open("/dev/null", O_RDONLY);
+        require(reused >= 0, "open a benign sentinel descriptor");
+    }
+    require(fcntl(reused, F_GETFD) >= 0, "destructor must not close a reused descriptor");
+    close(reused);
+}
+
+static void test_exclusive_destructor_releases() {
+    Pty pty;
+    {
+        AgileX::SerialPort port(pty.path, B38400);
+        require(open_watchdog(port, 0) == 0, "open for destructor release");
+    }
+    int retry = open(pty.path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    require(retry >= 0, "exclusive destructor must release a live PTY");
+    close(retry);
+}
+
+static void test_release_failure_still_closes_descriptor() {
+    Pty pty;
+    AgileX::SerialPort port(pty.path, B38400);
+    require(open_watchdog(port, 0) == 0, "open for release-failure test");
+    inject_release_failure = true;
+    injected_fd = -1;
+    const int result = port.closePort();
+    const int saved_errno = errno;
+    inject_release_failure = false;
+    require(result != 0 && saved_errno == EIO && injected_fd >= 0, "release failure is reported");
+    require(port.isOpen() == -1, "release failure resets fd state");
+    errno = 0;
+    require(fcntl(injected_fd, F_GETFD) < 0 && errno == EBADF, "release failure still closes fd");
+}
+
+int main() {
+    char hostname[64] = {0};
+    require(gethostname(hostname, sizeof(hostname)) == 0 &&
+            std::strcmp(hostname, "limo-exclusive-pty-isolated") == 0 &&
+            getpid() == 2 && getppid() == 1 && access("/dev/ttyTHS1", F_OK) != 0,
+            "refusing to run outside isolated PTY namespace");
+    test_default_is_nonexclusive();
+    test_watchdog_excludes_new_opens_and_releases();
+    test_failed_exclusive_ioctl_closes_new_descriptor();
+    test_later_setup_failure_releases_and_closes();
+    test_explicit_close_never_closes_a_reused_descriptor();
+    test_exclusive_destructor_releases();
+    test_release_failure_still_closes_descriptor();
+    std::puts("exclusive serial PTY checks passed");
+    return 0;
+}
