+// Test-only LD_PRELOAD injector. Never load into a process attached to hardware.
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+int ioctl(int fd, unsigned long request, ...) {
+    if (request == TIOCEXCL) {
+        static const char marker[] = "FAKE_TIOCEXCL_INJECTED\n";
+        (void)write(STDERR_FILENO, marker, sizeof(marker) - 1);
+        errno = EIO;
+        return -1;
+    }
+    va_list args;
+    va_start(args, request);
+    void *argument = va_arg(args, void *);
+    va_end(args);
+    int (*next_ioctl)(int, unsigned long, ...) = dlsym(RTLD_NEXT, "ioctl");
+    if (!next_ioctl) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return next_ioctl(fd, request, argument);
+}
