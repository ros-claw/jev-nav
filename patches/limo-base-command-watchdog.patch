+void LimoDriver::commandWatchdogCallback(const ros::SteadyTimerEvent& event) {
+    (void)event;
+    std::lock_guard<std::mutex> lock(motion_command_mutex_);
+    if (!command_watchdog_) return;
+    const double now = monotonicSeconds();
+    if (!commandWatchdogModeFresh(now)) command_watchdog_->mode_changed();
+    if (command_watchdog_->should_stop(now)) {
+        if (!setMotionCommand(0, 0, 0, 0)) command_watchdog_->record_write(false, monotonicSeconds());
+        if (command_watchdog_->is_latched()) {
+            ROS_ERROR_THROTTLE(1.0, "LIMO command watchdog timed out; zero command requested");
+        }
+    }
+    publishCommandWatchdogStatus(monotonicSeconds());
+}
+
+bool LimoDriver::commandWatchdogModeFresh(double now) const {
+    return last_mode_report_at_ > 0.0 && now >= last_mode_report_at_ && now - last_mode_report_at_ < 0.5;
+}
+
+void LimoDriver::publishCommandWatchdogStatus(double now) {
+    const uint8_t mode = commandWatchdogModeFresh(now) ? motion_mode_.load() : MODE_UNKNOWN;
+    std_msgs::String status;
+    status.data = "v2 " + command_watchdog_boot_id_ + " " +
+                  std::to_string(command_watchdog_->zero_writes()) + " " +
+                  std::to_string(static_cast<unsigned int>(mode)) + " " +
+                  (command_watchdog_->primed() ? "1" : "0") + " " +
+                  (command_watchdog_->is_latched() ? "1" : "0") + " " +
+                  (command_watchdog_->zero_source().empty() ? "none" : command_watchdog_->zero_source()) + " " +
+                  std::to_string(command_watchdog_->last_zero_write_at()) + " " +
+                  std::to_string(now);
+    command_watchdog_status_publisher_.publish(status);
 }
 
