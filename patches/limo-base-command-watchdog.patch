+#!/usr/bin/env python3
+"""Exercise only the candidate ROS driver against fresh namespace-local PTYs.
+
+Start under bwrap with isolated PID, network, and /dev. No real ROS master or
+serial device is used. The pseudo chassis only reads the initialization frame.
+"""
+
+import errno
+import os
+import pty
+import select
+import signal
+import socket
+import subprocess
+import tempfile
+import time
+import tty
+import xmlrpc.client
+from pathlib import Path
+
+
+CANDIDATE = '/tmp/rosclaw-limo-exclusive-candidate/devel/lib/limo_base/limo_base_node'
+
+
+def check_isolation():
+    allowed = {'core', 'fd', 'full', 'null', 'ptmx', 'pts', 'random', 'shm',
+               'stderr', 'stdin', 'stdout', 'tty', 'urandom', 'zero'}
+    if (socket.gethostname() != 'limo-exclusive-pty-isolated' or os.getpid() != 2
+            or os.getppid() != 1 or os.path.lexists('/dev/ttyTHS1')
+            or set(name for _, name in socket.if_nameindex()) != {'lo'}
+            or set(os.listdir('/dev')) - allowed or set(os.listdir('/dev/pts')) != {'ptmx'}):
+        raise RuntimeError('refusing to run outside isolated network/device/PTTY namespace')
+
+
+def stop(process):
+    if process is None or process.poll() is not None:
+        return
+    try:
+        os.killpg(process.pid, signal.SIGTERM)
+        process.wait(timeout=3)
+    except (OSError, subprocess.TimeoutExpired):
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        process.wait(timeout=3)
+
+
+def wait_master(uri, process):
+    deadline = time.monotonic() + 12
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError('isolated ROS master exited')
+        try:
+            if xmlrpc.client.ServerProxy(uri).getSystemState('/exclusive_pty_test')[0] == 1:
+                return
+        except (OSError, xmlrpc.client.Error):
+            time.sleep(0.1)
+    raise RuntimeError('isolated ROS master did not start')
+
+
+def wait_configuration(master_fd, process):
+    pending = b''
+    deadline = time.monotonic() + 8
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError('candidate exited before fake PTY initialization')
+        ready, _, _ = select.select([master_fd], [], [], 0.05)
+        if ready:
+            pending += os.read(master_fd, 4096)
+            if b'\x55\x0e\x04\x21' in pending:
+                return
+    raise RuntimeError('candidate did not initialize fake PTY')
+
+
+def run_case(enabled, env, run_dir):
+    master_fd, slave_fd = pty.openpty()
+    tty.setraw(slave_fd)
+    name = os.ttyname(slave_fd)
+    if not name.startswith('/dev/pts/'):
+        raise RuntimeError('serial target is not the test PTY')
+    link = run_dir / ('ttyWatchdog' if enabled else 'ttyDefault')
+    link.symlink_to(name)
+    if os.stat(str(link)).st_rdev != os.fstat(slave_fd).st_rdev:
+        raise RuntimeError('PTY target mismatch')
+    fake_port = os.path.relpath(str(link), '/dev')
+    owner = contender = None
+    log_path = run_dir / ('enabled.log' if enabled else 'default.log')
+    contender_path = run_dir / 'contender.log'
+    try:
+        with open(str(log_path), 'wb') as driver_log, open(str(contender_path), 'wb') as other_log:
+            args = [CANDIDATE, '__name:=' + ('exclusive_on' if enabled else 'exclusive_default'),
+                    '_port_name:=' + fake_port, '_pub_odom_tf:=false']
+            if enabled:
+                args.append('_command_watchdog_enabled:=true')
+            owner = subprocess.Popen(args, env=env, stdout=driver_log, stderr=driver_log,
+                                     start_new_session=True)
+            wait_configuration(master_fd, owner)
+            try:
+                second = os.open(name, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
+            except OSError as exc:
+                if not enabled or exc.errno != errno.EBUSY:
+                    raise
+                second = None
+            if enabled and second is not None:
+                os.close(second)
+                raise RuntimeError('watchdog enabled but a later PTY open succeeded')
+            if not enabled and second is None:
+                raise RuntimeError('default mode unexpectedly blocked a later PTY open')
+            if second is not None:
+                os.close(second)
+            if enabled:
+                contender = subprocess.Popen([
+                    CANDIDATE, '__name:=exclusive_contender', '_port_name:=' + fake_port,
+                    '_command_watchdog_enabled:=true', '_pub_odom_tf:=false',
+                ], env=env, stdout=other_log, stderr=other_log, start_new_session=True)
+                contender.wait(timeout=8)
+                other_log.flush()
+                if contender.returncode == 0 or b'Failed to open' not in contender_path.read_bytes():
+                    raise RuntimeError('second watchdog driver did not fail at serial open')
+                if owner.poll() is not None:
+                    raise RuntimeError('first candidate stopped during contender test')
+                # An already-open PTY slave remains usable; TIOCEXCL is not revocation.
+                if os.write(slave_fd, b'X') != 1:
+                    raise RuntimeError('preexisting descriptor unexpectedly stopped working')
+            return {'watchdog': enabled, 'later_open': 'EBUSY' if enabled else 'allowed',
+                    'second_driver_exit_nonzero': enabled}
+    finally:
+        stop(contender)
+        stop(owner)
+        os.close(slave_fd)
+        os.close(master_fd)
+
+
+def run_ioctl_failure(env, run_dir):
+    injector = '/tmp/fail_tiocexcl.so'
+    if not Path(injector).is_file():
+        raise RuntimeError('test-only TIOCEXCL failure injector missing')
+    master_fd, slave_fd = pty.openpty()
+    tty.setraw(slave_fd)
+    name = os.ttyname(slave_fd)
+    if not name.startswith('/dev/pts/'):
+        raise RuntimeError('serial target is not the test PTY')
+    link = run_dir / 'ttyFailure'
+    link.symlink_to(name)
+    if os.stat(str(link)).st_rdev != os.fstat(slave_fd).st_rdev:
+        raise RuntimeError('failure-case PTY target mismatch')
+    failure_env = dict(env, LD_PRELOAD=injector)
+    process = None
+    log_path = run_dir / 'injected-failure.log'
+    try:
+        with open(str(log_path), 'wb') as log:
+            process = subprocess.Popen([
+                CANDIDATE, '__name:=exclusive_injected_failure',
+                '_port_name:=' + os.path.relpath(str(link), '/dev'),
+                '_command_watchdog_enabled:=true', '_pub_odom_tf:=false',
+            ], env=failure_env, stdout=log, stderr=log, start_new_session=True)
+            process.wait(timeout=8)
+            log.flush()
+            output = log_path.read_bytes()
+            if (process.returncode == 0 or b'FAKE_TIOCEXCL_INJECTED' not in output
+                    or b'Failed to open' not in output):
+                raise RuntimeError('injected TIOCEXCL failure did not abort serial startup')
+            ready, _, _ = select.select([master_fd], [], [], 0.2)
+            if ready and os.read(master_fd, 4096):
+                raise RuntimeError('driver emitted serial data despite failed TIOCEXCL')
+            retry = os.open(name, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
+            os.close(retry)
+            return {'injected_tiocexcl_failure': 'startup_rejected',
+                    'initialization_frames': 0, 'pty_reopen': 'allowed'}
+    finally:
+        stop(process)
+        os.close(slave_fd)
+        os.close(master_fd)
+
+
+def main():
+    check_isolation()
+    if not Path(CANDIDATE).is_file():
+        raise RuntimeError('isolated candidate has not been built')
+    sock = socket.socket()
+    sock.bind(('127.0.0.1', 0))
+    port = sock.getsockname()[1]
+    sock.close()
+    uri = 'http://127.0.0.1:{}'.format(port)
+    with tempfile.TemporaryDirectory(prefix='limo-exclusive-') as temporary:
+        run_dir = Path(temporary)
+        env = {'PATH': '/opt/ros/melodic/bin:/usr/bin:/bin', 'ROS_MASTER_URI': uri,
+               'ROS_HOSTNAME': '127.0.0.1', 'ROS_IP': '127.0.0.1',
+               'ROS_HOME': str(run_dir / 'ros'), 'ROS_LOG_DIR': str(run_dir / 'logs'),
+               'ROS_ROOT': '/opt/ros/melodic/share/ros', 'ROS_DISTRO': 'melodic',
+               'ROS_PACKAGE_PATH': '/opt/ros/melodic/share',
+               'CMAKE_PREFIX_PATH': '/tmp/rosclaw-limo-exclusive-candidate/devel:/opt/ros/melodic',
+               'PYTHONPATH': '/tmp/rosclaw-limo-exclusive-candidate/devel/lib/python2.7/dist-packages:'
+                             '/opt/ros/melodic/lib/python2.7/dist-packages',
+               'LD_LIBRARY_PATH': '/tmp/rosclaw-limo-exclusive-candidate/devel/lib:/opt/ros/melodic/lib',
+               'PYTHONDONTWRITEBYTECODE': '1'}
+        master = None
+        try:
+            with open(str(run_dir / 'master.log'), 'wb') as log:
+                master = subprocess.Popen(['/opt/ros/melodic/bin/roscore', '-p', str(port)], env=env,
+                                          stdout=log, stderr=log, start_new_session=True)
+                wait_master(uri, master)
+                results = [run_case(False, env, run_dir), run_case(True, env, run_dir),
+                           run_ioctl_failure(env, run_dir)]
+                print('candidate ROS driver PTY checks passed: {}'.format(results))
+        finally:
+            stop(master)
+
+
+if __name__ == '__main__':
+    main()
