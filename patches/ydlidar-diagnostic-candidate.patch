+// Exercise real CYdLidar::doProcessSimple with in-memory link-time scan stubs.
+// The real driver instance is never connected or started, and no serial port
+// is opened. Link wrappers replace both isscanning() and grabScanData().
+#include <bits/stdc++.h>
+#define private public
+#include "CYdLidar.h"
+#undef private
+
+static std::vector<node_info> synthetic_nodes;
+
+extern "C" bool __wrap__ZNK7ydlidar13YDlidarDriver10isscanningEv(const ydlidar::YDlidarDriver *) {
+  return true;
+}
+
+extern "C" result_t __wrap__ZN7ydlidar13YDlidarDriver12grabScanDataEP9node_infoRmj(
+    ydlidar::YDlidarDriver *, node_info *buffer, size_t &count, uint32_t) {
+  if (count < synthetic_nodes.size()) return RESULT_FAIL;
+  count = synthetic_nodes.size();
+  std::copy(synthetic_nodes.begin(), synthetic_nodes.end(), buffer);
+  return RESULT_OK;
+}
+
+static node_info node(unsigned int angle_degrees, unsigned int distance_q2) {
+  node_info value = {};
+  value.angle_q6_checkbit = angle_degrees * 64U * 2U;
+  value.distance_q2 = distance_q2;
+  return value;
+}
+
+static void require(bool condition, const char *reason) {
+  if (!condition) {
+    std::cerr << "FAIL: " << reason << std::endl;
+    std::exit(1);
+  }
+}
+
+int main(int argc, char **argv) {
+  const std::string chosen = argc > 1 ? argv[1] : "under";
+  ydlidar::YDlidarDriver driver;
+  CYdLidar laser;
+  laser.lidarPtr = &driver;
+  laser.isScanning = true;
+  laser.m_ParseSuccess = true;
+  laser.m_FixedSize = 8;
+  laser.setFixedResolution(true);
+  laser.setMinAngle(-90);
+  laser.setMaxAngle(90);
+  if (chosen == "under") {
+    synthetic_nodes.push_back(node(0, 4000));
+    synthetic_nodes.push_back(node(30, 0));
+    synthetic_nodes.push_back(node(330, 8000));
+  } else if (chosen == "over") {
+    for (unsigned int i = 0; i < 10; ++i) synthetic_nodes.push_back(node(i, 4000));
+  } else if (chosen == "boundaries") {
+    laser.m_FixedSize = 374;
+    synthetic_nodes.push_back(node(90, 4000));
+    synthetic_nodes.push_back(node(270, 8000));
+  } else if (chosen == "empty") {
+    synthetic_nodes.push_back(node(0, 4000));
+  } else {
+    return 2;
+  }
+  LaserScan scan;
+  bool error = true;
+  const bool success = laser.doProcessSimple(scan, error);
+  laser.lidarPtr = NULL;  // driver is a stack object and was never connected
+  if (chosen == "empty") {
+    require(!success, "a scan with fewer than two raw nodes must be rejected");
+  } else {
+    require(success && !error, "synthetic scan rejected");
+    require(scan.points.size() == synthetic_nodes.size(),
+            "SDK must not pad or truncate actual point samples");
+    if (chosen == "under") {
+      require(scan.points[1].range == 0, "real SDK-invalid sample must remain present");
+    }
+  }
+  std::cout << "SDK point checks passed: " << chosen << std::endl;
+}
