+// Exercise the actual node's publishing code with an in-memory SDK/ROS harness.
+// No real serial ports, ROS master, hardware, or topics are used.
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+#include <limits>
+#include <string>
+#include <vector>
+#include "CYdLidar.h"
+#include "sensor_msgs/LaserScan.h"
+
+ydlidar::LaserScan ydlidar::fake_scan;
+static sensor_msgs::LaserScan published;
+static int published_count = 0;
+static int ok_count = 0;
+namespace ros {
+void init(int, char **, const char *) {}
+bool ok() { return ok_count++ == 0; }
+void spinOnce() {}
+void Publisher::publish(const sensor_msgs::LaserScan &message) const {
+  published = message;
+  ++published_count;
+}
+}
+
+#define main ydlidar_node_main
+#include "../src/ydlidar_node.cpp"
+#undef main
+
+static void require(bool condition, const char *reason) {
+  if (!condition) {
+    std::cerr << "FAIL: " << reason << std::endl;
+    std::exit(1);
+  }
+}
+
+static void point(float angle, float range, float intensity) {
+  ydlidar::LaserPoint value;
+  value.angle = angle;
+  value.range = range;
+  value.intensity = intensity;
+  ydlidar::fake_scan.points.push_back(value);
+}
+
+static void run_node() {
+  char name[] = "test";
+  char *argv[] = {name, NULL};
+  ok_count = 0;
+  published_count = 0;
+  require(ydlidar_node_main(1, argv) == 0, "node returned a failure");
+}
+
+static void reset_scan() {
+  ydlidar::fake_scan.points.clear();
+  ydlidar::fake_scan.config.min_angle = -2;
+  ydlidar::fake_scan.config.max_angle = 2;
+  ydlidar::fake_scan.config.angle_increment = 1;
+  ydlidar::fake_scan.config.min_range = 0.1;
+  ydlidar::fake_scan.config.max_range = 10;
+  ydlidar::fake_scan.config.scan_time = 0.1;
+  ydlidar::fake_scan.config.time_increment = 0.02;
+  ydlidar::fake_scan.stamp = 10;
+}
+
+static void missing_and_invalid() {
+  reset_scan();
+  point(-2, 1, 5);
+  point(0, 0, 0);
+  point(2, 2, 6);
+  run_node();
+  require(published_count == 1 && published.ranges.size() == 5, "incorrect scan size");
+  require(std::isnan(published.ranges[1]) && std::isnan(published.ranges[3]),
+          "unsampled bins must be NaN rather than a fabricated zero");
+  require(published.ranges[2] == 0, "actual SDK invalid sample must remain zero");
+  require(published.ranges[0] == 1 && published.ranges[4] == 2, "actual hits must survive");
+}
+
+static void duplicate_buckets() {
+  reset_scan();
+  point(0, 1, 5);
+  point(0, 0, 0);
+  point(0, 2, 9);
+  run_node();
+  require(published_count == 1 && published.ranges[2] == 1,
+          "duplicate valid/invalid samples must retain closest positive hit");
+  require(published.intensities[2] == 5, "intensity must match the retained hit");
+  reset_scan();
+  point(0, 2, 9);
+  point(0, 1, 5);
+  point(0, 0, 0);
+  run_node();
+  require(published_count == 1 && published.ranges[2] == 1,
+          "duplicate resolution must not depend on input ordering");
+}
+
+static void rounded_endpoints() {
+  reset_scan();
+  ydlidar::fake_scan.config.min_angle = -1.57079637f;
+  ydlidar::fake_scan.config.max_angle = 1.57079637f;
+  ydlidar::fake_scan.config.angle_increment =
+      (ydlidar::fake_scan.config.max_angle - ydlidar::fake_scan.config.min_angle) / 373;
+  point(ydlidar::fake_scan.config.min_angle, 1, 5);
+  point(ydlidar::fake_scan.config.max_angle, 2, 6);
+  point(ydlidar::fake_scan.config.max_angle + 0.1f, 3, 7);
+  point(std::numeric_limits<float>::quiet_NaN(), 4, 8);
+  run_node();
+  require(published_count == 1 && published.ranges.size() == 374,
+          "rounded float increment must retain the full grid");
+  require(published.ranges[0] == 1 && published.ranges[373] == 2,
+          "both exact endpoints must survive, out-of-range angle must not overwrite");
+}
+
+static void invalid_geometry() {
+  reset_scan();
+  ydlidar::fake_scan.config.angle_increment = 0;
+  run_node();
+  require(published_count == 0, "zero angle increment must fail closed without publishing");
+}
+
+static void half_window_does_not_invent_coverage() {
+  reset_scan();
+  ydlidar::fake_scan.config.min_angle = -1.57079637f;
+  ydlidar::fake_scan.config.max_angle = 1.57079637f;
+  const float span = ydlidar::fake_scan.config.max_angle - ydlidar::fake_scan.config.min_angle;
+  ydlidar::fake_scan.config.angle_increment = span / 360;
+  for (int i = 0; i <= 180; ++i) {
+    const float angle = i == 180 ? ydlidar::fake_scan.config.max_angle
+                                 : ydlidar::fake_scan.config.min_angle + span * i / 180;
+    point(angle, 1, 1);
+  }
+  run_node();
+  size_t unknown = 0, hits = 0;
+  for (size_t i = 0; i < published.ranges.size(); ++i) {
+    if (std::isnan(published.ranges[i])) ++unknown;
+    if (published.ranges[i] == 1) ++hits;
+  }
+  require(published.ranges.size() == 361 && hits == 181 && unknown == 180,
+          "half-window oversampling must expose holes, not fill or invent returns");
+}
+
+int main(int argc, char **argv) {
+  const std::string chosen = argc > 1 ? argv[1] : "all";
+  if (chosen == "all" || chosen == "missing") missing_and_invalid();
+  if (chosen == "all" || chosen == "duplicate") duplicate_buckets();
+  if (chosen == "all" || chosen == "endpoints") rounded_endpoints();
+  if (chosen == "all" || chosen == "invalid") invalid_geometry();
+  if (chosen == "all" || chosen == "half") half_window_does_not_invent_coverage();
+  std::cout << "ROS publishing checks passed: " << chosen << std::endl;
+}
