+#!/usr/bin/env bash
+# Offline-only tests: the SDK scan and ROS publisher are in-memory substitutes.
+# Usage: bash tests/run_candidate_tests.sh /absolute/path/to/isolated/catkin/build
+set -euo pipefail
+
+if [ "$#" -ne 1 ] || [ ! -d "$1/ydlidar_ros/CMakeFiles/ydlidar_node.dir/sdk/src" ]; then
+  printf 'Pass the isolated catkin build directory as the only argument.\n' >&2
+  exit 2
+fi
+package_dir=$(cd "$(dirname "$0")/.." && pwd)
+build_dir=$(cd "$1" && pwd)
+test_dir="$build_dir/ydlidar-offline-tests"
+objects="$build_dir/ydlidar_ros/CMakeFiles/ydlidar_node.dir/sdk/src"
+mkdir -p "$test_dir"
+cd "$package_dir"
+source /opt/ros/melodic/setup.bash
+
+g++ -std=c++11 -Itests/fakes tests/test_ros_pipeline.cpp -o "$test_dir/ros_pipeline"
+"$test_dir/ros_pipeline"
+
+g++ -std=c++11 -Isdk/include tests/test_sdk_points.cpp "$objects"/*.o "$objects"/impl/unix/*.o \
+  -Wl,--wrap=_ZN7ydlidar13YDlidarDriver12grabScanDataEP9node_infoRmj \
+  -Wl,--wrap=_ZNK7ydlidar13YDlidarDriver10isscanningEv -pthread -lrt -o "$test_dir/sdk_points"
+for scenario in under over boundaries empty; do "$test_dir/sdk_points" "$scenario"; done
+
+g++ -std=c++11 -I/opt/ros/melodic/include tests/test_laserscan_serialization.cpp \
+  -L/opt/ros/melodic/lib -lroscpp_serialization -lrostime -lcpp_common -lboost_system \
+  -pthread -o "$test_dir/laserscan_serialization"
+"$test_dir/laserscan_serialization"
