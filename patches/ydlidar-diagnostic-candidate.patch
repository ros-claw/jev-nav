+// Check actual ROS LaserScan wire serialization entirely in memory.
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <vector>
+#include <ros/serialization.h>
+#include <sensor_msgs/LaserScan.h>
+
+int main() {
+  sensor_msgs::LaserScan scan;
+  scan.ranges.push_back(std::numeric_limits<float>::quiet_NaN());
+  scan.ranges.push_back(0.0f);
+  scan.ranges.push_back(2.0f);
+  const uint32_t length = ros::serialization::serializationLength(scan);
+  std::vector<uint8_t> bytes(length);
+  ros::serialization::OStream output(bytes.data(), length);
+  ros::serialization::serialize(output, scan);
+  sensor_msgs::LaserScan restored;
+  ros::serialization::IStream input(bytes.data(), length);
+  ros::serialization::deserialize(input, restored);
+  if (restored.ranges.size() != 3 || !std::isnan(restored.ranges[0]) ||
+      restored.ranges[1] != 0.0f || restored.ranges[2] != 2.0f) {
+    std::cerr << "FAIL: LaserScan wire serialization changed the range categories" << std::endl;
+    return 1;
+  }
+  std::cout << "ROS LaserScan NaN/zero/hit serialization passed" << std::endl;
+}
