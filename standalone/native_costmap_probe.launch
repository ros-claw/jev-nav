<launch>
  <!-- Diagnostic only: no node in this launch publishes velocity commands. -->
  <arg name="namespace" />
  <arg name="use_fresh" default="false" />
  <arg name="depth_rate" default="5" />
  <arg name="grid_rate" default="10.0" />
  <arg name="decimate_depth" default="false" />
  <arg name="project_image" default="depth_image" />
  <arg name="project_info" default="/camera/depth/camera_info" />
  <arg name="depth_points_args" default="standalone depth_image_proc/point_cloud_xyz" />
  <arg name="depth_layer_type" default="costmap_2d::ObstacleLayer" />
  <arg name="inflate" default="true" />
  <group ns="$(arg namespace)">
    <node unless="$(arg decimate_depth)" pkg="topic_tools" type="throttle" name="depth_throttle"
          args="messages /camera/depth/image_raw $(arg depth_rate) /$(arg namespace)/depth_image"
          output="screen" />
    <node if="$(arg decimate_depth)" pkg="nodelet" type="nodelet" name="depth_pipeline"
          args="manager" output="screen" required="true">
      <param name="num_worker_threads" value="2" />
    </node>
    <node if="$(arg decimate_depth)" pkg="nodelet" type="nodelet" name="depth_decimate"
          args="load image_proc/crop_decimate depth_pipeline" output="screen">
      <remap from="camera/image_raw" to="/camera/depth/image_raw" />
      <remap from="camera/camera_info" to="/camera/depth/camera_info" />
      <param name="decimation_x" value="2" />
      <param name="decimation_y" value="2" />
      <param name="queue_size" value="2" />
    </node>
    <node pkg="nodelet" type="nodelet" name="depth_points"
          args="$(arg depth_points_args)" output="screen">
      <remap from="image_rect" to="$(arg project_image)" />
      <remap from="camera_info" to="$(arg project_info)" />
      <remap from="points" to="/$(arg namespace)/depth_points" />
      <param name="queue_size" value="2" />
    </node>
    <node pkg="costmap_2d" type="costmap_2d_node" name="rolling_costmap" output="screen" required="true">
      <remap from="/tf" to="/$(arg namespace)/tf" />
      <rosparam ns="costmap" subst_value="true">
        global_frame: odom
        robot_base_frame: base_link
        update_frequency: $(arg grid_rate)
        publish_frequency: 10.0
        rolling_window: true
        width: 3.0
        height: 3.0
        resolution: 0.05
        transform_tolerance: 0.3
        track_unknown_space: true
        always_send_full_costmap: true
        footprint: [[-0.16, -0.11], [-0.16, 0.11], [0.16, 0.11], [0.16, -0.11]]
        laser:
          enabled: true
          track_unknown_space: true
          footprint_clearing_enabled: false
          max_scan_age: 0.3
          obstacle_range: 3.0
          raytrace_range: 3.5
          observation_sources: forward_scan
          forward_scan: {data_type: LaserScan, topic: /scan, marking: true, clearing: true,
                         inf_is_valid: false, observation_persistence: 0.0, expected_update_rate: 0.2}
        depth:
          enabled: true
          track_unknown_space: true
          footprint_clearing_enabled: false
          observation_sources: depth_points
          depth_points: {data_type: PointCloud2, topic: /$(arg namespace)/depth_points,
                         marking: true, clearing: false, min_obstacle_height: -0.05,
                         max_obstacle_height: 0.4, expected_update_rate: 0.0}
        inflation: {enabled: $(arg inflate), inflation_radius: 0.2, cost_scaling_factor: 10.0}
      </rosparam>
      <rosparam if="$(arg use_fresh)" ns="costmap" param="plugins" subst_value="true">
        - {name: laser, type: "limo_fresh_layer/FreshLaserLayer"}
        - {name: depth, type: "$(arg depth_layer_type)"}
        - {name: inflation, type: "costmap_2d::InflationLayer"}
        - {name: snapshot, type: "limo_fresh_layer/FreshGridSnapshotLayer"}
      </rosparam>
      <rosparam unless="$(arg use_fresh)" ns="costmap" param="plugins">
        - {name: laser, type: "costmap_2d::ObstacleLayer"}
        - {name: depth, type: "costmap_2d::ObstacleLayer"}
        - {name: inflation, type: "costmap_2d::InflationLayer"}
      </rosparam>
    </node>
  </group>
</launch>
