<launch>
  <!-- Fully synthetic, private inputs; this layer does not publish velocities. -->
  <arg name="namespace" />
  <arg name="allow_inf" default="false" />
  <arg name="track_unknown" default="true" />
  <group ns="$(arg namespace)">
    <node pkg="costmap_2d" type="costmap_2d_node" name="rolling_costmap" output="screen" required="true">
      <remap from="/tf" to="/$(arg namespace)/tf" />
      <rosparam ns="costmap" subst_value="true">
        global_frame: odom
        robot_base_frame: base_link
        update_frequency: 10.0
        publish_frequency: 10.0
        rolling_window: true
        width: 3.0
        height: 3.0
        resolution: 0.05
        transform_tolerance: 0.3
        track_unknown_space: $(arg track_unknown)
        always_send_full_costmap: true
        footprint: [[-0.16, -0.11], [-0.16, 0.11], [0.16, 0.11], [0.16, -0.11]]
        plugins:
          - {name: fresh_laser, type: "limo_fresh_layer/FreshLaserLayer"}
          - {name: depth, type: "costmap_2d::ObstacleLayer"}
          - {name: snapshot, type: "limo_fresh_layer/FreshGridSnapshotLayer"}
        fresh_laser:
          enabled: true
          track_unknown_space: true
          footprint_clearing_enabled: false
          max_scan_age: 0.3
          obstacle_range: 3.0
          raytrace_range: 3.5
          observation_sources: scan
          scan: {data_type: LaserScan, topic: /$(arg namespace)/scan, marking: true, clearing: true,
                 inf_is_valid: $(arg allow_inf), observation_persistence: 0.0, expected_update_rate: 0.2}
        depth:
          enabled: true
          track_unknown_space: true
          footprint_clearing_enabled: false
          observation_sources: points
          points: {data_type: PointCloud2, topic: /$(arg namespace)/depth_points,
                   marking: true, clearing: false, min_obstacle_height: -0.05,
                   max_obstacle_height: 0.4, expected_update_rate: 0.0}
      </rosparam>
    </node>
  </group>
</launch>
