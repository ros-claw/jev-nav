<launch>
  <arg name="database_path"/>
  <arg name="localization" default="false"/>
  <!-- The fixed camera's unregistered depth remains on the separate hazard path. -->
  <include file="$(find rtabmap_ros)/launch/rtabmap.launch">
    <arg name="database_path" value="$(arg database_path)"/>
    <arg name="localization" value="$(arg localization)"/>
    <arg name="frame_id" value="base_link"/>
    <arg name="odom_topic" value="/odom"/>
    <arg name="depth" value="false"/>
    <arg name="subscribe_rgb" value="false"/>
    <arg name="subscribe_scan" value="true"/>
    <arg name="scan_topic" value="/scan"/>
    <arg name="visual_odometry" value="false"/>
    <arg name="icp_odometry" value="false"/>
    <arg name="rtabmapviz" value="false"/>
    <arg name="rviz" value="false"/>
    <arg name="args" value="--Reg/Strategy 1 --Reg/Force3DoF true --Grid/FromDepth false"/>
  </include>
</launch>
